<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>音樂節奏怪獸派對 - 精準感應版</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka+One&display=swap');

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #38BDF8;
            font-family: 'Fredoka One', cursive;
            -webkit-user-select: none;
            user-select: none;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        canvas {
            display: block;
            touch-action: none;
        }

        .ui-layer {
            position: absolute;
            top: env(safe-area-inset-top, 20px);
            pointer-events: none;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 20px;
            box-sizing: border-box;
            z-index: 100;
        }

        .feedback-text {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 60px;
            color: #FFD700;
            text-shadow: 4px 4px 0px rgba(0,0,0,0.1);
            opacity: 0;
            z-index: 200;
            pointer-events: none;
            transition: opacity 0.15s, transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .overlay {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            color: white;
            text-align: center;
            padding: 20px;
        }

        .level-selection-container {
            width: 100%;
            max-width: 600px;
            max-height: 35vh;
            overflow-y: auto;
            padding: 10px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 15px;
            -webkit-overflow-scrolling: touch;
        }

        .level-card {
            background: #38BDF8;
            padding: 15px;
            border-radius: 20px;
            cursor: pointer;
            box-shadow: 0 6px 0 #0284C7;
            border: 3px solid white;
            transition: transform 0.1s;
        }

        .level-card:active { transform: scale(0.95); }

        .btn-primary {
            background: #F472B6;
            color: white;
            padding: 12px 30px;
            border-radius: 50px;
            font-size: 20px;
            cursor: pointer;
            box-shadow: 0 6px 0 #BE185D;
            border: none;
            margin: 5px;
            text-transform: uppercase;
        }

        .settings-panel {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            padding: 20px;
            margin-bottom: 20px;
            width: 100%;
            max-width: 420px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .mic-visualizer-bg {
            width: 100%;
            height: 12px;
            background: rgba(0,0,0,0.3);
            border-radius: 6px;
            overflow: hidden;
            margin-top: 5px;
            position: relative;
        }

        #mic-visualizer-fill {
            width: 0%;
            height: 100%;
            background: #4ADE80;
            transition: width 0.05s;
        }

        /* 門檻指示線 */
        #threshold-marker {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 3px;
            background: #F87171;
            box-shadow: 0 0 5px rgba(248, 113, 113, 0.8);
            z-index: 10;
        }

        .custom-slider {
            -webkit-appearance: none;
            flex-grow: 1;
            height: 10px;
            border-radius: 5px;
            background: rgba(0, 0, 0, 0.4);
            outline: none;
        }

        .custom-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #FDE047;
            cursor: pointer;
            border: 3px solid #FFF;
        }

        .heart-icon {
            display: inline-block;
            width: 22px;
            height: 22px;
            background-color: #EF4444;
            clip-path: path('M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z');
            margin-right: 3px;
        }

        .heart-lost { background-color: #64748b; opacity: 0.3; }
    </style>
</head>
<body>

<div id="game-container">
    <div class="ui-layer" id="game-ui" style="display: none;">
        <div class="flex flex-col gap-1">
            <div id="score-display" class="text-2xl text-white font-bold">0</div>
            <div id="hearts-container" class="flex"></div>
        </div>
        <div class="flex flex-col items-end gap-1">
            <div id="status-display" class="text-3xl text-pink-400 font-bold">READY?</div>
            <div id="difficulty-indicator" class="text-xs font-bold px-3 py-1 rounded-full text-white">演奏</div>
        </div>
    </div>

    <div id="combo-display" class="absolute left-5 top-24 text-4xl text-yellow-300 font-bold z-50 pointer-events-none" style="display: none; text-shadow: 3px 3px 0 #CA8A04;">0 COMBO</div>
    <div id="feedback" class="feedback-text">GREAT!</div>

    <canvas id="gameCanvas"></canvas>

    <!-- 初始選單 -->
    <div id="menu-screen" class="overlay">
        <h1 class="text-5xl md:text-6xl mb-2 font-bold text-white tracking-widest">Rhythm Kitty</h1>
        <p class="text-sm md:text-lg mb-4 text-blue-200 font-bold">請嘗試拍手或打鼓來測試感應</p>
        
        <div class="settings-panel">
            <div class="flex justify-between items-center">
                <span class="text-white font-bold text-sm">🎤 感應門檻 (越右邊需要越大聲)</span>
                <span id="mic-val" class="text-yellow-300 text-xs">50</span>
            </div>
            <div class="flex gap-4 items-center">
                <input type="range" id="mic-slider" class="custom-slider" min="5" max="95" value="50" oninput="updateSettings()">
            </div>
            <div class="mic-visualizer-bg">
                <div id="mic-visualizer-fill"></div>
                <div id="threshold-marker"></div>
            </div>
            <p id="mic-status" class="text-[10px] text-gray-400">正在自動偵測環境噪音...</p>
            
            <div class="flex justify-between items-center mt-2">
                <span class="text-white font-bold text-sm">🎵 節拍器音量</span>
            </div>
            <input type="range" id="vol-slider" class="custom-slider" min="0" max="100" value="40" oninput="updateSettings()">
        </div>

        <div class="flex gap-2 mb-4">
            <div id="btn-practice" class="px-4 py-2 rounded-xl bg-emerald-500 cursor-pointer font-bold text-sm border-2 border-transparent" onclick="setDifficulty('practice')">練習</div>
            <div id="btn-performance" class="px-4 py-2 rounded-xl bg-amber-500 cursor-pointer font-bold text-sm border-2 border-white" onclick="setDifficulty('performance')">標準</div>
            <div id="btn-master" class="px-4 py-2 rounded-xl bg-red-500 cursor-pointer font-bold text-sm border-2 border-transparent" onclick="setDifficulty('master')">大師</div>
        </div>

        <div class="level-selection-container" id="level-selection"></div>
    </div>

    <!-- 結果畫面 -->
    <div id="result-screen" class="overlay" style="display: none;">
        <h2 id="result-title" class="text-5xl mb-6 font-bold">挑戰完成！</h2>
        <div class="bg-white p-8 rounded-3xl mb-10 text-slate-800 w-72 shadow-2xl">
            <p class="text-3xl mb-1 font-bold">得分：<span id="final-score" class="text-pink-500">0</span></p>
            <p class="text-sm text-slate-400 font-bold uppercase tracking-widest">Best: <span id="best-score">0</span></p>
        </div>
        <div class="flex flex-col gap-4 w-64">
            <button class="btn-primary" onclick="restartLevel()">再次挑戰</button>
            <button class="btn-primary" style="background: #34D399; box-shadow: 0 6px 0 #059669;" onclick="backToMenu()">返回首頁</button>
        </div>
    </div>
</div>

<script>
    const BPM = 75;
    const SECONDS_PER_BEAT = 60 / BPM;
    const BASE_UNIT = 220; 
    const START_LINE_X = 120; 
    const PHRASES_PER_LEVEL = 12;
    const INITIAL_HP = 8;

    const DIFFICULTY_SETTINGS = {
        practice: { name: "練習", perfect: 0.20, great: 0.35, color: "#10B981" },
        performance: { name: "演奏", perfect: 0.12, great: 0.25, color: "#F59E0B" },
        master: { name: "大師", perfect: 0.06, great: 0.15, color: "#EF4444" }
    };

    let currentDifficulty = 'performance';
    let currentLevel = 1;
    let score = 0;
    let hp = INITIAL_HP;
    let combo = 0;
    let maxCombo = 0;
    let isGameRunning = false;
    let gameState = 'MENU'; 
    let startTime = 0;
    let lastPlayedBeat = -1;
    
    // 音訊感測變數
    let micThreshold = 50; 
    let metronomeVolume = 0.08; 
    let noiseFloor = 0; // 環境噪音基準
    let lastInputTime = 0; // 防止連點抖動

    let audioCtx;
    let analyser, dataArray;
    let micStream;
    
    let globalPlatforms = [];
    let globalNotes = [];

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const feedbackEl = document.getElementById('feedback');
    const scoreEl = document.getElementById('score-display');
    const statusEl = document.getElementById('status-display');
    const comboEl = document.getElementById('combo-display');
    const heartsContainer = document.getElementById('hearts-container');
    const menuScreen = document.getElementById('menu-screen');
    const resultScreen = document.getElementById('result-screen');
    const gameUI = document.getElementById('game-ui');
    const diffIndicator = document.getElementById('difficulty-indicator');
    const micFill = document.getElementById('mic-visualizer-fill');
    const micStatus = document.getElementById('mic-status');
    const marker = document.getElementById('threshold-marker');

    const player = { y: 0, scaleX: 1, scaleY: 1 };

    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        player.y = canvas.height * 0.65;
    }
    window.addEventListener('resize', resize);
    resize();

    const levelsData = [
        { id: 1, name: "入門節奏", patterns: [['ta', 'ta', 'ta', 'ta'], ['ta', 'rest', 'ta', 'rest']] },
        { id: 2, name: "雙音練習", patterns: [['ta', 'ti', 'ta', 'ti'], ['ti', 'ti', 'ta', 'ta']] },
        { id: 3, name: "切分初探", patterns: [['ti', 'ti', 'ta', 'rest'], ['ta', 'ti', 'ti', 'ta']] },
        { id: 4, name: "快速連打", patterns: [['ta', 'tiritiri', 'ta', 'ta'], ['tiritiri', 'ti', 'ta', 'rest']] },
        { id: 5, name: "輕快組合", patterns: [['ti-tiri', 'ta', 'ti-tiri', 'ta'], ['ta', 'ti-tiri', 'ti', 'ti']] },
        { id: 6, name: "大師律動", patterns: [['ti-ri', 'ta', 'ti-ri', 'ta'], ['ti-ri', 'ti-tiri', 'ta', 'ta']] }
    ];

    function updateSettings() {
        micThreshold = parseInt(document.getElementById('mic-slider').value);
        document.getElementById('mic-val').innerText = micThreshold;
        marker.style.left = micThreshold + '%';
        metronomeVolume = (parseInt(document.getElementById('vol-slider').value) / 100) * 0.2;
        
        if (!analyser) initAudio();
    }

    function initHearts() {
        heartsContainer.innerHTML = '';
        for (let i = 0; i < INITIAL_HP; i++) {
            const heart = document.createElement('div');
            heart.className = 'heart-icon';
            heartsContainer.appendChild(heart);
        }
    }

    function setDifficulty(diff) {
        currentDifficulty = diff;
        ['practice', 'performance', 'master'].forEach(d => {
            document.getElementById(`btn-${d}`).style.borderColor = (d === diff) ? 'white' : 'transparent';
        });
        initMenu();
    }

    function initMenu() {
        const grid = document.getElementById('level-selection');
        grid.innerHTML = '';
        levelsData.forEach(lvl => {
            const best = localStorage.getItem(`best_score_lvl_${lvl.id}_${currentDifficulty}`) || 0;
            const card = document.createElement('div');
            card.className = 'level-card';
            card.onclick = () => startLevel(lvl.id);
            card.innerHTML = `<div class="text-[10px] text-white opacity-80 font-bold">LV 0${lvl.id}</div><div class="text-lg font-bold text-white leading-tight">${lvl.name}</div><div class="text-[10px] text-blue-100 font-bold mt-1">BEST: ${best}</div>`;
            grid.appendChild(card);
        });
        marker.style.left = micThreshold + '%';
    }

    async function initAudio() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') await audioCtx.resume();
        
        if (micStream) return;

        try {
            // 停用所有自動增益和降噪，獲取最原始的打擊訊號
            micStream = await navigator.mediaDevices.getUserMedia({ 
                audio: { 
                    echoCancellation: false, 
                    noiseSuppression: false, 
                    autoGainControl: false 
                } 
            });
            analyser = audioCtx.createAnalyser();
            const source = audioCtx.createMediaStreamSource(micStream);
            source.connect(analyser);
            analyser.fftSize = 512;
            dataArray = new Uint8Array(analyser.frequencyBinCount);
            micStatus.innerText = "🎤 麥克風已就緒 - 請點選關卡開始";
            micStatus.style.color = "#4ADE80";
            monitorMic();
        } catch (err) { 
            micStatus.innerText = "❌ 無法存取麥克風，請檢查權限";
            micStatus.style.color = "#EF4444";
        }
    }

    function monitorMic() {
        if (!analyser) return;
        analyser.getByteFrequencyData(dataArray);
        
        let sum = 0;
        let peak = 0;
        for(let i=0; i<dataArray.length; i++) {
            sum += dataArray[i];
            if(dataArray[i] > peak) peak = dataArray[i];
        }
        
        const average = sum / dataArray.length;
        const currentVolume = (peak / 255) * 100;
        
        // 更新環境噪音基準 (緩慢追蹤環境底噪)
        if (currentVolume < noiseFloor || noiseFloor === 0) {
            noiseFloor = currentVolume;
        } else {
            noiseFloor = noiseFloor * 0.999 + currentVolume * 0.001;
        }

        // 視覺化
        micFill.style.width = currentVolume + '%';
        micFill.style.background = currentVolume > micThreshold ? '#F87171' : '#4ADE80';

        // 判定擊發條件：
        // 1. 當前峰值 > 使用者設定的門檻
        // 2. 當前峰值 > 環境噪音 + 一定的餘裕 (防止噪音漂移)
        // 3. 距離上次輸入超過 80ms (防止單次擊打產生多次觸發)
        const now = Date.now();
        if (currentVolume > micThreshold && currentVolume > noiseFloor + 5 && now - lastInputTime > 80) {
            if (isGameRunning) {
                handleInput();
            }
            lastInputTime = now;
        }

        requestAnimationFrame(monitorMic);
    }

    function playMetronomeSound(isDownbeat) {
        if (!audioCtx || metronomeVolume <= 0) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(isDownbeat ? 880 : 440, audioCtx.currentTime);
        gain.gain.setValueAtTime(metronomeVolume, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + 0.05);
    }

    function generateLevel(levelId) {
        globalPlatforms = []; globalNotes = [];
        const lvlInfo = levelsData.find(l => l.id === levelId);
        for (let p = 0; p < PHRASES_PER_LEVEL; p++) {
            let baseX = p * 5 * BASE_UNIT; let startBeat = p * 8; 
            globalPlatforms.push({ type: 'count_in', worldX: baseX, width: BASE_UNIT * 0.7, height: 100 });
            let selectedPattern = lvlInfo.patterns[Math.floor(Math.random() * lvlInfo.patterns.length)];
            selectedPattern.forEach((noteType, index) => {
                let localBeatIndex = 4 + index; 
                let platformX = baseX + (index + 1) * BASE_UNIT; 
                globalPlatforms.push({ type: 'challenge', worldX: platformX, width: BASE_UNIT * 0.8, height: 100, noteType });
                
                if (noteType === 'ta') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'ta', hit: false, parentX: platformX, subPos: 0, beamToNext: 0 });
                } else if (noteType === 'rest') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'rest', hit: false, parentX: platformX, subPos: 0, beamToNext: 0 });
                } else if (noteType === 'ti') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'ti', hit: false, parentX: platformX, subPos: -0.15, beamToNext: 1 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.5, type: 'ti', hit: false, parentX: platformX, subPos: 0.15, beamToNext: 0 });
                } else if (noteType === 'tiritiri') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'tiri', hit: false, parentX: platformX, subPos: -0.24, beamToNext: 2 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.25, type: 'tiri', hit: false, parentX: platformX, subPos: -0.08, beamToNext: 2 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.5, type: 'tiri', hit: false, parentX: platformX, subPos: 0.08, beamToNext: 2 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.75, type: 'tiri', hit: false, parentX: platformX, subPos: 0.24, beamToNext: 0 });
                } else if (noteType === 'ti-tiri') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'ti-tiri', hit: false, parentX: platformX, subPos: -0.2, beamToNext: 1 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.5, type: 'ti-tiri', hit: false, parentX: platformX, subPos: 0.04, beamToNext: 2 });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.75, type: 'ti-tiri', hit: false, parentX: platformX, subPos: 0.24, beamToNext: 0 });
                } else if (noteType === 'ti-ri') {
                    globalNotes.push({ time: startBeat + localBeatIndex, type: 'ti-ri', hit: false, parentX: platformX, subPos: -0.15, beamToNext: 1, dot: true });
                    globalNotes.push({ time: startBeat + localBeatIndex + 0.75, type: 'ti-ri', hit: false, parentX: platformX, subPos: 0.2, beamToNext: 0, beamStub: 'left' });
                }
            });
        }
    }

    async function startLevel(id) {
        await initAudio();
        
        currentLevel = id; score = 0; hp = INITIAL_HP; combo = 0; maxCombo = 0; lastPlayedBeat = -1;
        initHearts();
        const settings = DIFFICULTY_SETTINGS[currentDifficulty];
        diffIndicator.innerText = settings.name;
        diffIndicator.style.backgroundColor = settings.color;
        
        menuScreen.style.display = 'none'; resultScreen.style.display = 'none';
        gameUI.style.display = 'flex'; comboEl.style.display = 'block'; comboEl.innerText = "0 COMBO";
        
        generateLevel(currentLevel);
        startTime = Date.now(); isGameRunning = true; gameState = 'PLAYING';
        requestAnimationFrame(gameLoop);
    }

    function handleInput() {
        if (!isGameRunning || gameState !== 'PLAYING') return;
        const currentBeatFloat = Math.max(0, (Date.now() - startTime) / 1000) / SECONDS_PER_BEAT;
        let closest = null; let minDist = Infinity;
        
        globalNotes.forEach(n => {
            if (n.hit || n.missed || n.type === 'rest') return;
            let dist = Math.abs(currentBeatFloat - n.time) * SECONDS_PER_BEAT;
            if (dist < minDist) { minDist = dist; closest = n; }
        });

        const sets = DIFFICULTY_SETTINGS[currentDifficulty];
        if (closest && minDist < sets.great) {
            closest.hit = true; 
            combo++; 
            if (combo > maxCombo) maxCombo = combo;
            const isPerf = minDist < sets.perfect;
            score += isPerf ? 100 : 50;
            comboEl.innerText = `${combo} COMBO`;
            showFeedback(isPerf ? "PERFECT!" : "GREAT!", isPerf ? "#FDE047" : "#FFFFFF");
            player.scaleX = 1.4; player.scaleY = 0.6;
        } else {
            // 只有在真的點擊（非空氣點擊）且遊戲中才扣血
            takeDamage();
        }
    }

    function takeDamage() {
        if (hp <= 0) return;
        hp--; combo = 0; comboEl.innerText = `0 COMBO`;
        const hearts = heartsContainer.children;
        if (hearts[hp]) hearts[hp].classList.add('heart-lost');
        showFeedback("MISS!", "#EF4444");
        if (hp <= 0) showResults(true);
    }

    function showFeedback(txt, color) {
        feedbackEl.innerText = txt; feedbackEl.style.color = color; feedbackEl.style.opacity = 1;
        feedbackEl.style.transform = 'translate(-50%, -50%) scale(1.2)';
        setTimeout(() => { 
            feedbackEl.style.opacity = 0; 
            feedbackEl.style.transform = 'translate(-50%, -50%) scale(1)'; 
        }, 300);
    }

    function showResults(failed = false) {
        isGameRunning = false; gameState = 'RESULT'; gameUI.style.display = 'none'; comboEl.style.display = 'none';
        const bestKey = `best_score_lvl_${currentLevel}_${currentDifficulty}`;
        let best = localStorage.getItem(bestKey) || 0;
        if (!failed && score > best) { best = score; localStorage.setItem(bestKey, score); }
        document.getElementById('result-title').innerText = failed ? "挑戰失敗" : "完成挑戰！";
        document.getElementById('result-title').style.color = failed ? "#EF4444" : "#10B981";
        document.getElementById('final-score').innerText = score; document.getElementById('best-score').innerText = best;
        resultScreen.style.display = 'flex';
    }

    function backToMenu() { resultScreen.style.display = 'none'; menuScreen.style.display = 'flex'; initMenu(); }
    function restartLevel() { startLevel(currentLevel); }

    function drawPlatform(platform, screenX, screenY) {
        const w = platform.width; const h = platform.height;
        const color = platform.type === 'count_in' ? '#0EA5E9' : '#C084FC';
        ctx.fillStyle = color;
        ctx.beginPath(); ctx.roundRect(screenX - w/2, screenY, w, h, 15); ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.3)';
        ctx.beginPath(); ctx.roundRect(screenX - w/2, screenY, w, 25, {tl: 15, tr: 15}); ctx.fill();
    }

    function drawCat(x, y, beatFloat) {
        const jump = Math.sin((beatFloat % 1) * Math.PI) * -140;
        player.scaleX += (1.0 - player.scaleX) * 0.15; player.scaleY += (1.0 - player.scaleY) * 0.15;
        
        ctx.save(); ctx.translate(x, y + jump); ctx.scale(player.scaleX, player.scaleY);
        ctx.fillStyle = '#FFFFFF';
        ctx.beginPath(); ctx.moveTo(-20, -40); ctx.lineTo(-12, -65); ctx.lineTo(-4, -45); 
        ctx.moveTo(20, -40); ctx.lineTo(12, -65); ctx.lineTo(4, -45); ctx.fill();
        ctx.beginPath(); ctx.roundRect(-30, -50, 60, 50, 15); ctx.fill();
        ctx.fillStyle = '#1E293B'; ctx.beginPath(); ctx.arc(-12, -25, 4, 0, Math.PI*2); ctx.arc(12, -25, 4, 0, Math.PI*2); ctx.fill();
        ctx.restore();
    }

    function gameLoop() {
        if (!isGameRunning) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const elapsed = (Date.now() - startTime) / 1000;
        const currentBeatFloat = elapsed / SECONDS_PER_BEAT;
        const currentPhrase = Math.floor(currentBeatFloat / 8);
        const localBeat = currentBeatFloat % 8;
        
        if (currentPhrase >= PHRASES_PER_LEVEL) { showResults(); return; }
        
        let scroll = currentPhrase * 5 * BASE_UNIT;
        if (localBeat >= 3) scroll += (localBeat - 3) * BASE_UNIT;

        ctx.fillStyle = '#38BDF8'; ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#34D399'; ctx.fillRect(0, player.y + 60, canvas.width, canvas.height);

        globalPlatforms.forEach(p => {
            const sx = START_LINE_X + p.worldX - scroll;
            if (sx > -200 && sx < canvas.width + 200) drawPlatform(p, sx, player.y);
        });

        globalNotes.forEach((n, idx) => {
            let sx = START_LINE_X + n.parentX - scroll + (n.subPos * BASE_UNIT);
            if (sx > -100 && sx < canvas.width + 100 && !n.hit) {
                const ny = player.y + 75; 
                ctx.fillStyle = '#1E293B'; ctx.strokeStyle = '#1E293B';
                if (n.type === 'rest') {
                    ctx.lineWidth = 4; ctx.beginPath();
                    ctx.moveTo(sx - 6, ny - 40); ctx.lineTo(sx + 6, ny - 25); ctx.lineTo(sx - 4, ny - 15);
                    ctx.bezierCurveTo(sx + 10, ny - 10, sx + 8, ny + 5, sx - 6, ny + 5); ctx.stroke();
                } else {
                    ctx.beginPath(); ctx.ellipse(sx, ny, 10, 8, -0.3, 0, Math.PI*2); ctx.fill();
                    ctx.fillRect(sx + 7, ny - 40, 4, 40); 
                    if (n.dot) { ctx.beginPath(); ctx.arc(sx + 20, ny - 2, 4, 0, Math.PI*2); ctx.fill(); }
                    if (n.beamToNext > 0) {
                        const next = globalNotes[idx+1];
                        if (next && next.parentX === n.parentX) {
                            const nextX = START_LINE_X + next.parentX - scroll + (next.subPos * BASE_UNIT);
                            ctx.fillRect(sx + 7, ny - 40, (nextX - sx) + 4, 6);
                            if (n.beamToNext === 2) ctx.fillRect(sx + 7, ny - 28, (nextX - sx) + 4, 6);
                        }
                    }
                }
            }
            if (!n.hit && !n.missed && currentBeatFloat > n.time + 0.3) {
                n.missed = true; if (n.type !== 'rest') takeDamage();
            }
        });

        drawCat(START_LINE_X, player.y, currentBeatFloat);
        
        const bn = Math.floor(currentBeatFloat % 4);
        ctx.fillStyle = 'rgba(0,0,0,0.2)'; ctx.beginPath(); ctx.roundRect(canvas.width/2 - 60, canvas.height - 50, 120, 30, 15); ctx.fill();
        for(let i=0; i<4; i++) {
            ctx.fillStyle = i === bn ? '#FDE047' : 'rgba(255,255,255,0.3)';
            ctx.beginPath(); ctx.arc(canvas.width/2 - 45 + i*30, canvas.height - 35, i === bn ? 8 : 5, 0, Math.PI*2); ctx.fill();
        }

        if (Math.floor(currentBeatFloat) > lastPlayedBeat) {
            playMetronomeSound(Math.floor(currentBeatFloat) % 4 === 0);
            lastPlayedBeat = Math.floor(currentBeatFloat);
        }

        scoreEl.innerText = `SCORE: ${score}`;
        statusEl.innerText = localBeat < 4 ? `READY ${Math.floor(localBeat)+1}` : "GO!";
        requestAnimationFrame(gameLoop);
    }

    initMenu();

    canvas.addEventListener('touchstart', e => { e.preventDefault(); handleInput(); }, {passive: false});
    canvas.addEventListener('mousedown', e => { e.preventDefault(); handleInput(); });
    window.addEventListener('keydown', e => { 
        if(e.code === 'Space' || e.code === 'Enter') { e.preventDefault(); handleInput(); }
    });
</script>

</body>
</html>
